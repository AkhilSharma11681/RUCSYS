# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://user:password@hostname:5432/db_name?sslmode=require"

# NextAuth (Auth.js) Configuration
# Generate a secret with: npx auth secret
AUTH_SECRET="your-generated-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Resend Mail Provider (for magic links)
RESEND_API_KEY="re_..."
EMAIL_FROM="RUCSYS <noreply@yourdomain.com>"
